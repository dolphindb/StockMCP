defg calc_mdd(nav) { return max(1 - nav / cummax(1.0 join nav)[1:]) }

def evaluate_stock_factor(factor, holdingPeriod, startDate, endDate, industries, sessionId) {
    // factor = "pe"
    // holdingPeriod = 5
    // startDate = "2023.01.01"
    // endDate = "2023.12.31"
    // industries = []
    // sessionId = "sess_12345"

    // --- 0. 参数校验 ---
    if (isNull(factor)) throw "错误：因子名称不能为空"
    if (holdingPeriod <= 0 or holdingPeriod != int(holdingPeriod)) throw "错误：持有期必须为正整数"
    if (isNull(startDate) or isNull(endDate)) throw "错误：起始日期和结束日期不能为空"
    if (isNull(sessionId)) throw "错误：Session ID不能为空"

    // --- 1. 获取因子数据 ---
    // 定义时间列兼容性
    timeColName = "trade_date" 
    
    if (factor in exec name from objs(true)) {
        // 路径A：内存表 (假设结构: securityid, trade_date/tradetime, value)
        memTable = objByName(factor)
        cols = colNames(memTable)
        actualTimeCol = iif("tradetime" in cols, "tradetime", "trade_date")
        
        params = dict(STRING, ANY)
        params["tbl"] = memTable
        params["dt_start"] = date(startDate)
        params["dt_end"] = date(endDate)
        
        sqlStr = "select date(" + actualTimeCol + ") as trade_date, symbol(securityid) as securityid, double(value) as factor_value from tbl where date(" + actualTimeCol + ") >= dt_start and date(" + actualTimeCol + ") <= dt_end"
        factorData = runSQL(sqlStr, , params)
    } else {
        // 路径B：数据库读取 (dfs://day_factor)
        factorData = select tradetime as trade_date, securityid, value as factor_value
                     from loadTable("dfs://factor", "day_factor")
                     where factorname == factor
                     and tradetime >= date(startDate) and tradetime <= date(endDate)
    }

    if (size(factorData) == 0) throw "错误：未查询到因子数据"

    // --- 2. 行业筛选 (如果 industries 为空则跳过筛选) ---
    if (size(industries) > 0) {
        industryData = select ts_code as securityid, industry 
                       from loadTable("dfs://basic_factor", "stock_basic")
                       where industry in industries
        
        factorData = select f.* 
                     from factorData f 
                     inner join industryData i on f.securityid = i.securityid
        
        if (size(factorData) == 0) throw "错误：行业筛选后数据为空"
    }

    // Compute returns for each SAME security before joining sparse factor rows.
    stock_daily = select trade_date, ts_code as securityid, close from loadTable("dfs://day_factor", "stock_daily_prev")
                  where trade_date between date(startDate):date(endDate)
    returns = select trade_date, securityid,
                     move(close,-int(holdingPeriod))/close-1 as forward_return,
                     move(close,-1)/close-1 as next_return
              from stock_daily context by securityid csort trade_date
    samples = select f.trade_date,f.securityid,f.factor_value,r.forward_return,r.next_return
              from factorData f inner join returns r on f.securityid=r.securityid and f.trade_date=r.trade_date
              where isValid(f.factor_value)
    ic_base = select * from samples where isValid(forward_return)
    daily_ic_stats = select corr(factor_value,forward_return) as ic from ic_base group by trade_date
    mean_ic_val = mean(daily_ic_stats.ic)
    ic_std = std(daily_ic_stats.ic)
    ic_ir_val = iif(ic_std==0,0.0,mean_ic_val/ic_std)
    // Stable quintiles: sort factor then security, partition into exactly 1..5.
    nav_base = select *,int(floor(rowNo(factor_value)*5 \ count(factor_value)))+1 as layer
               from samples where isValid(next_return)
               context by trade_date csort factor_value,securityid
    nav_base = select * from nav_base context by trade_date having count(*)>=5
    if (size(nav_base)==0) throw "至少需要5只股票及两个交易日的有效因子和行情数据"
    layer_ret = select mean(next_return) as ret from nav_base group by trade_date,layer
    ret_pivot = select ret from layer_ret pivot by trade_date,layer
    rename!(ret_pivot,string(1..5),"group_"+string(1..5))
    hs300_daily = select trade_date,close from loadTable("dfs://day_factor","index_daily")
                  where ts_code="000300.SH" and trade_date between date(startDate):date(endDate)
                  order by trade_date
    if (size(hs300_daily)<2) throw "缺少沪深300指数行情，请导入 index_daily"
    bench_ret = select trade_date,move(close,-1)/close-1 as hs300 from hs300_daily
    univ_ret = select mean(next_return) as benchmark_port from samples group by trade_date
    final_df = select * from lj(lj(ret_pivot,bench_ret,`trade_date),univ_ret,`trade_date) order by trade_date
    if (any(isNull(final_df.hs300))) throw "基准行情未覆盖全部评价日期"

    // 5.8 计算累计净值 (Start=1)
    nav_table = select trade_date,
                       cumprod(1+group_1) as group_1, cumprod(1+group_2) as group_2,
                       cumprod(1+group_3) as group_3, cumprod(1+group_4) as group_4,
                       cumprod(1+group_5) as group_5, 
                       cumprod(1+benchmark_port) as benchmark_port,
                       cumprod(1+hs300) as hs300
                from final_df

    // --- 6. 计算绩效指标表 ---
    
    metrics = table(100:0, ["Portfolio", "Ann_Return", "Ann_Volatility", "Sharpe_Ratio", "Max_Drawdown", 
                            "Ann_Excess_Ret", "Ann_Excess_Vol", "Info_Ratio", "Win_Rate_Rel_Bench", "Excess_Max_Drawdown"], 
                            [STRING, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE])
    
    port_cols = ["group_1", "group_2", "group_3", "group_4", "group_5", "benchmark_port", "hs300"]
    bm_ret_seq = final_df["hs300"] // 统一使用沪深300作为超额基准

    for (col in port_cols) {
        ret_seq = final_df[col]
        nav_seq = nav_table[col]
        
        // 绝对指标
        ann_ret = pow(last(nav_seq), 252.0/size(nav_seq)) - 1
        ann_vol = std(ret_seq) * sqrt(252)
        sharpe = iif(ann_vol==0, 0, ann_ret / ann_vol)
        mdd = calc_mdd(nav_seq)
        
        // 相对指标 (vs HS300)
        ex_ret_seq = ret_seq - bm_ret_seq
        ex_nav_seq = cumprod(1 + ex_ret_seq)
        
        ann_ex_ret = mean(ex_ret_seq) * 252
        ann_ex_vol = std(ex_ret_seq) * sqrt(252)
        ir = iif(ann_ex_vol==0, 0, ann_ex_ret / ann_ex_vol)
        ex_mdd = calc_mdd(ex_nav_seq)
        
        // 月度胜率
        t_m = table(month(final_df.trade_date) as m, ret_seq as r, bm_ret_seq as b)
        m_agg = select sum(r) as mr, sum(b) as mb from t_m group by m
        win_rate = exec count(*) from m_agg where mr > mb
        win_rate = win_rate \ size(m_agg)
        
        insert into metrics values(col, ann_ret, ann_vol, sharpe, mdd, ann_ex_ret, ann_ex_vol, ir, win_rate, ex_mdd)
    }

    // 增加多空组合 (Top - Bottom: Group 5 - Group 1)
    ls_ret = final_df["group_5"] - final_df["group_1"]
    ls_nav = cumprod(1 + ls_ret)
    
    ann_ls_ret = mean(ls_ret) * 252
    ann_ls_vol = std(ls_ret) * sqrt(252)
    sharpe_ls = iif(ann_ls_vol==0, 0, ann_ls_ret / ann_ls_vol)
    mdd_ls = calc_mdd(ls_nav)
    
    insert into metrics values("Long_Short_Top_Bottom", ann_ls_ret, ann_ls_vol, sharpe_ls, mdd_ls, ann_ls_ret, ann_ls_vol, sharpe_ls, 0.0, mdd_ls)

    // --- 7. 注册共享内存表 ---
    // 格式: nav_data_{sessionId}, perf_metrics_{sessionId}
    tableNameNAV = "nav_data_" + sessionId
    tableNamePerf = "perf_metrics_" + sessionId
    
    // 清理同名旧表 (如果有)
    try { undef(tableNameNAV, SHARED) } catch(ex) {}
    try { undef(tableNamePerf, SHARED) } catch(ex) {}
    
    share(nav_table, tableNameNAV)
    share(metrics, tableNamePerf)
    dashboardUrl = export_table_to_csv(tableNameNAV)

    // --- 8. 返回结果 ---
    res = dict(STRING, ANY)
    res["factor_name"] = factor
    res["mean_ic"] = mean_ic_val
    res["ic_ir"] = ic_ir_val
    res["nav_table"] = tableNameNAV
    res["perf_table"] = tableNamePerf
    res["summary"] = "因子评估完成。\n平均IC: " + string(round(mean_ic_val, 4)) + 
                     "\nICIR: " + string(round(ic_ir_val, 3)) +
                     "\n多空年化收益: " + string(round(ann_ls_ret*100, 2)) + "%" +
                     "\n多空夏普比率: " + string(round(sharpe_ls, 2)) + 
                     "\n可视化报告URL: " + dashboardUrl
    
    return toStdJson(res)
}

description_evaluate_stock_factor = '
用于评估指定因子在不同行业中的表现，生成详细的回测净值曲线和风险绩效指标表。注意，当返回给用户报告的URL时，先不要清理内存表，以免用户访问时报错。

参数说明：
- factor: STRING，因子名称，例如 "pe"。如果是衍生出的新因子，则直接填写内存表名。
- holdingPeriod: INT，IC计算的持有期窗口（注：净值曲线默认按日调仓计算）。
- startDate: STRING，起始日期，格式 "yyyy.MM.dd"。
- endDate: STRING，结束日期，格式 "yyyy.MM.dd"。
- industries: STRING[]，行业列表，如 ["银行"]。若为空 []，则进行全市场回测。
- sessionId: STRING，会话ID，用于生成唯一的共享表名。

返回：
- JSON 因子评价的摘要，以及两个共享内存表的表名：
  1. nav_table: 包含日期、5层组合净值、基准组合净值、沪深300净值。
  2. perf_table: 包含各组合的年化收益、波动率、夏普、最大回撤、超额收益、信息比率、相对胜率等。
  3. summary: 因子评价的文字摘要，包括平均IC、ICIR、多空组合表现、可视化报告的URL，返回 CSV 导出路径或已配置下载链接。

    evaluate_stock_factor(
        "pe",                // 因子名称
        5,                   // 持有期（5日）
        "2023.01.01",        // 起始日期
        "2023.12.31",        // 结束日期
        ["银行", "非银金融"], // 行业列表（可为空[]表示全市场）
        "sess_12345"         // sessionId
    )
'

if (`evaluate_stock_factor in (exec name from listMCPTools())) {
  updateMCPTool(`evaluate_stock_factor, evaluate_stock_factor, 
                `factor`holdingPeriod`startDate`endDate`industries`sessionId, 
                ["STRING", "DOUBLE", "STRING", "STRING", "STRING[]", "STRING"], 
                description_evaluate_stock_factor)
} else {
  addMCPTool(`evaluate_stock_factor, evaluate_stock_factor, 
                `factor`holdingPeriod`startDate`endDate`industries`sessionId, 
                ["STRING", "DOUBLE", "STRING", "STRING", "STRING[]", "STRING"], 
                description_evaluate_stock_factor)
}

publishMCPTools(`evaluate_stock_factor)
