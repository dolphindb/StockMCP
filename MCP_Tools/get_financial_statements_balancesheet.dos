def get_financial_statements_balancesheet(stockCodes, endDates, resultTableName, sessionId){
    // 加载分布式表并筛选
    t = select * from loadTable("dfs://quarter_factor", "quarter_stock_balancesheet") where ts_code in stockCodes and end_date in date(endDates)
    // 如果 sessionId 不为空，则共享结果表
    if (trim(sessionId) != "") {
        if (trim(resultTableName) != "") {
            resultName = resultTableName + "_" + sessionId
            share(t, resultName)
            return "查询成功：共享表名 " + resultName + "\n前10行数据：\n" + toStdJson(t[0:min(10, t.size())])
        }
    }
    // 如果 sessionId 为空，直接返回查询结果
    return "查询成功：前10行数据：\n" + toStdJson(t[0:min(10, t.size())])
}

description_get_financial_statements_balancesheet = '
用于从 DolphinDB 资产负债表 stock_balancesheet 加载指定股票代码在指定报告期的资产负债数据，并将结果保存为共享内存表供后续分析使用。

参数说明：
- stockCodes: STRING[]，股票代码列表
- endDates: STRING[]，报告期列表,必填，如["2010.06.30", "2010.09.30", "2010.12.31"]
- resultTableName: STRING，共享内存表名，用于后续分析。建议使用有意义的名称如 "statements_balancesheet"
- sessionId: STRING，当前会话唯一id，用于生成唯一的共享表名。如果为空，则不共享内存表，直接返回查询结果

返回：
- 操作结果信息，包含共享表名（如果有）和前10行样例数据

示例：

// 查询两只股票的资产负债信息（完整代码）
get_stock_basic_info(["600519.SH", "000001.SZ"], ["2008.09.30", "2008.12.31"], "statements_balancesheet", "session123")

// 查询两只股票的资产负债信息（完整代码，且不共享内存表）
get_stock_basic_info(["600519.SH", "000001.SZ"], ["2010.06.30", "2010.09.30", "2010.12.31"], "", "")

// 查询两只股票三个季度的资产负债信息（完整代码）
get_stock_basic_info(["600519.SH", "000001.SZ"], ["2010.06.30", "2010.09.30", "2010.12.31"], "statements_balancesheet", "session123")

// 查询两只股票一年的资产负债信息（完整代码）
get_stock_basic_info(["600519.SH", "000001.SZ"], ["2010.12.31"], "statements_balancesheet", "session123")
'

if (`get_financial_statements_balancesheet in (exec name from listMCPTools())) {
  updateMCPTool(`get_financial_statements_balancesheet, get_financial_statements_balancesheet, 
                `stockCodes`endDates`resultTableName`sessionId, 
                ["STRING[]", "STRING[]", "STRING", "STRING"], 
                description_get_financial_statements_balancesheet)
} else {
  addMCPTool(`get_financial_statements_balancesheet, get_financial_statements_balancesheet, 
                `stockCodes`endDates`resultTableName`sessionId, 
                ["STRING[]", "STRING[]", "STRING", "STRING"], 
                description_get_financial_statements_balancesheet)
}

publishMCPTools(`get_financial_statements_balancesheet)
