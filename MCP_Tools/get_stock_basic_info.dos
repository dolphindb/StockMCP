def get_stock_basic_info(stockCodes, resultTableName, sessionId){
    // 加载分布式表并筛选
    if (size(stockCodes) == 0) {
        return "错误：股票代码列表不能为空"
    }
    t = select * from loadTable("dfs://basic_factor", "stock_basic") where ts_code in stockCodes or symbol in stockCodes
        // 检查查询结果是否为空
    if (size(t) == 0) {
        return "错误：未找到匹配的股票基础信息，请检查股票代码是否正确"
    }
    // 如果 sessionId 不为空，则共享结果表
    if (trim(sessionId) != "") {
        if (trim(resultTableName) != "") {
            resultName = resultTableName + "_" + sessionId
            share(t, resultName)
            return "查询成功：共享表名 " + resultName + "\n前10行数据：\n" + toStdJson(t[0:min(10, t.size())])
        }
    }

    result = dict(STRING, ANY)
    result["查询结果前十行"] = t[0:min(10, t.size())]
    // 如果 sessionId 为空，直接返回查询结果
    return toStdJson(result)
}

description_get_stock_basic_info = '
用于从 DolphinDB 基础信息表 stock_basic 加载指定股票代码的基础信息，并将结果保存为共享内存表供后续分析使用。内容包括以下字段：ts_code(股票代码)、symbol(股票简称)、name(股票名称)、area(地区)、industry(行业)、market(市场类型)、list_date(上市日期)、act_name(活跃名称)、act_ent_type(活跃实体类型)。

参数说明：
- stockCodes: STRING[]，股票代码列表，需要查看几个股票必须一个个填入代码
- resultTableName: STRING，共享内存表名，用于后续分析。建议使用有意义的名称如 "basic_info"
- sessionId: STRING，当前会话唯一id，用于生成唯一的共享表名。如果为空，则不共享内存表，直接返回查询结果

返回：
- 操作结果信息，包含共享表名（如果有）和前10行样例数据

示例：

// 查询两只股票的基础信息（完整代码）
get_stock_basic_info(["600519.SH", "000001.SZ"], "basic_info", "session123")

// 查询两只股票的基础信息（混合代码，且不共享内存表）
get_stock_basic_info(["600519", "000001.SZ"], "", "")
'

if (`get_stock_basic_info in (exec name from listMCPTools())) {
  updateMCPTool(`get_stock_basic_info, get_stock_basic_info, 
                `stockCodes`resultTableName`sessionId, 
                ["STRING[]", "STRING", "STRING"], 
                description_get_stock_basic_info)
} else {
  addMCPTool(`get_stock_basic_info, get_stock_basic_info, 
                `stockCodes`resultTableName`sessionId, 
                ["STRING[]", "STRING", "STRING"], 
                description_get_stock_basic_info)
}

publishMCPTools(`get_stock_basic_info)

